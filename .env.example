# ===========================================================================
# VEYRA — example environment file
# ===========================================================================
# This file contains FAKE values and is safe to commit.
#
# Copy it to `.env` for local backend development only. `.env` is ignored by
# git. End users never edit this file: API keys are entered in
# Settings -> Models / API keys and stored in Windows Credential Manager.
#
# Never commit a real key, token, client secret, path or account identifier.
# ===========================================================================

# --- Backend transport (loopback only) -------------------------------------
# Do not change the host: the backend must never listen on a public interface.
VEYRA_HOST=127.0.0.1
# 0 = pick a free port at startup and report it to the Tauri shell.
VEYRA_PORT=0
# Generated per run by the shell. This placeholder is not a secret.
VEYRA_SESSION_TOKEN=replace-me-at-every-start

# --- Local model (Ollama) ---------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
VEYRA_LOCAL_MODEL=qwen3:4b
VEYRA_CONTEXT_TOKENS=4096
VEYRA_TEMPERATURE=0.2

# --- Optional online model (OpenAI-compatible chat completions) -------------
# Disabled unless the user configures a base URL, a model and a key.
VEYRA_ONLINE_ENABLED=false
VEYRA_ONLINE_BASE_URL=https://api.example.invalid/v1
VEYRA_ONLINE_MODEL=example-model
# Fake placeholder. Real keys live in Credential Manager, never in this file.
VEYRA_ONLINE_API_KEY=example-not-a-real-key

# --- Speech -----------------------------------------------------------------
# Wake word, STT and TTS models are downloaded on demand, never committed.
VEYRA_STT_MODEL=base
VEYRA_STT_COMPUTE_TYPE=int8
VEYRA_TTS_ENGINE=piper
VEYRA_WAKE_WORD=hey_veyra
VEYRA_WAKE_ENGINE=openwakeword

# --- Integrations (optional, disabled by default) ---------------------------
VEYRA_GITHUB_ENABLED=false
VEYRA_GITHUB_READ_ONLY=true
VEYRA_GOOGLE_ENABLED=false
VEYRA_GOOGLE_READ_ONLY=true
# Maintainer-owned Desktop OAuth client; end users do not edit this file.
# Release builds inject the matching repository secrets and bundle the client.
VEYRA_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
VEYRA_GOOGLE_CLIENT_SECRET=example-not-a-real-secret
# User refresh tokens stay in Credential Manager, not in this file.

# --- Runtime ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
VEYRA_LOG_LEVEL=INFO
# Disable animations, WebGL and background polling.
VEYRA_LOW_POWER=false
# Unload speech models when free RAM drops below this value (megabytes).
VEYRA_RAM_FLOOR_MB=900
