# Normalize text files to LF in the repository; keep Windows scripts CRLF.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff2 binary
*.ttf binary
*.otf binary
*.exe binary
*.dll binary
*.msi binary
